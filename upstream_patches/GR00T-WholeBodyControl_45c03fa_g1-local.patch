+class ChordDetector:
+    """PICO face-button chords (2026-11-16). A+B+X+Y fires on the rising edge of all four. A+X (or B+Y) fires only
+    after it has been held ALONE (no B/Y, resp. no A/X) for `settle` s, so the A and X that usually land first while
+    pressing A+B+X+Y never count as an A+X. After A+B+X+Y nothing else fires until all four buttons are released
+    (a sloppy release that keeps A+X held cannot start following)."""
+
+    def __init__(self, settle: float = 0.3):
+        self.settle = settle
+        self.prev_all = False
+        self.prev_ax = False
+        self.prev_by = False
+        self.ax_t0 = None
+        self.by_t0 = None
+        self.locked = False
+
+    def update(self, a: bool, b: bool, x: bool, y: bool, now: float):
+        all4 = bool(a and b and x and y)
+        start_edge = all4 and not self.prev_all
+        if all4:
+            self.locked = True
+        elif not (a or b or x or y):
+            self.locked = False
+        ax = bool(a and x and not (b or y)) and not self.locked
+        by = bool(b and y and not (a or x)) and not self.locked
+        ax_edge = by_edge = False
+        if ax and not self.prev_ax:
+            self.ax_t0 = now
+        if not ax:
+            self.ax_t0 = None
+        if self.ax_t0 is not None and now - self.ax_t0 >= self.settle:
+            ax_edge, self.ax_t0 = True, None            # once per press
+        if by and not self.prev_by:
+            self.by_t0 = now
+        if not by:
+            self.by_t0 = None
+        if self.by_t0 is not None and now - self.by_t0 >= self.settle:
+            by_edge, self.by_t0 = True, None
+        self.prev_all, self.prev_ax, self.prev_by = all4, ax, by
+        return start_edge, ax_edge, by_edge
+
+
+def next_stream_mode(current, start_edge, ax_edge, by_edge, axis_click_edge, menu_held, pause_source, vr3pt_parent):
+    """PICO mode state machine (2026-11-16, operator request). Returns (new_mode, pause_source, note).
+
+      OFF        --A+B+X+Y--> PLANNER       start the policy (robot stands in place)
+      PLANNER    --A+X------> POSE          whole-body follow
+                 --A+B+X+Y--> (nothing)     the PICO never stops the policy: damping / stop only from the
+                                            workstation (app e-stop, real_teleop.sh estop), so a mistaken press can
+                                            never drop the robot
+      POSE       --A+X------> POSE_PAUSE    hold the last frame (body, arms, hands: the deploy clamps to it)
+                 --A+B+X+Y--> PLANNER       back to standing in place
+      POSE_PAUSE --A+X------> POSE          resume (yaw re-anchored; the robot moves to the operator's CURRENT pose,
+                                            so put the arms back near the paused pose first)
+                 --A+B+X+Y--> PLANNER       back to standing in place
+    Unchanged sub-modes: POSE <-B+Y-> PLANNER_FROZEN_UPPER_BODY <-left axis click-> PLANNER_VR_3PT,
+    PLANNER <-left axis click-> PLANNER_VR_3PT; holding the left menu button in POSE pauses until it is released
+    (pause_source "menu"; an A+X pause is only ended by A+X or A+B+X+Y). A+B+X+Y in FROZEN / VR_3PT -> PLANNER.
+    OFF is never re-entered from the PICO.
+    """
+    S = StreamMode
+    new, note = current, None
+    if current == S.OFF:
+        if start_edge:
+            new = S.PLANNER
+    elif current == S.PLANNER:
+        if start_edge:
+            note = "A+B+X+Y in PLANNER: ignored (the PICO never stops the policy; stop it from the workstation)"
+        elif ax_edge:
+            new = S.POSE
+        elif axis_click_edge:
+            new = S.PLANNER_VR_3PT
+    elif current == S.POSE:
+        if start_edge:
+            new = S.PLANNER
+        elif ax_edge:
+            new, pause_source = S.POSE_PAUSE, "ax"
+        elif by_edge:
+            new = S.PLANNER_FROZEN_UPPER_BODY
+        elif menu_held:
+            new, pause_source = S.POSE_PAUSE, "menu"
+    elif current == S.POSE_PAUSE:
+        if start_edge:
+            new = S.PLANNER
+        elif ax_edge:
+            new = S.POSE
+        elif pause_source == "menu" and not menu_held:
+            new = S.POSE
+    elif current == S.PLANNER_FROZEN_UPPER_BODY:
+        if start_edge:
+            new = S.PLANNER
+        elif by_edge:
+            new = S.POSE
+        elif axis_click_edge:
+            new = S.PLANNER_VR_3PT
+    elif current == S.PLANNER_VR_3PT:
+        if start_edge:
+            new = S.PLANNER
+        elif axis_click_edge:
+            new = vr3pt_parent
+        elif ax_edge or by_edge:
+            new = S.POSE
+    if new != S.POSE_PAUSE:
+        pause_source = None
+    return new, pause_source, note
+
