+def _dispatch_key(dispatcher, key):
+    """PICO A / B (data collection start / abort) and the sim reset key go through dispatcher.handle_key, which
+    only the local KeyboardDispatcher has. The real robot runs a ROSKeyboardDispatcher: calling it raised
+    AttributeError and killed the control loop (2026-11-17, PICO B). Recording is done by the g1_hub recorder,
+    so on the real robot these keys are ignored (logged)."""
+    if hasattr(dispatcher, "handle_key"):
+        dispatcher.handle_key(key)
+    else:
+        print(f"[dwbc] PICO key '{key}' ignored (data collection is not used on the real robot)", flush=True)
+
+
 def main(config: ControlLoopConfig):
     ros_manager = ROSManager(node_name=CONTROL_NODE_NAME)
     node = ros_manager.node
