                 # Start or Stop data collection
                 if wbc_goal.get("toggle_data_collection", False):
-                    dispatcher.handle_key("c")
+                    _dispatch_key(dispatcher, "c")
 
                 # Abort the current episode
                 if wbc_goal.get("toggle_data_abort", False):
-                    dispatcher.handle_key("x")
+                    _dispatch_key(dispatcher, "x")
+
+                # PICO A+B+X+Y (patch_reset.py): lower-body policy ON, idempotent (never a toggle). Called on the
+                # policy directly: the real robot's ROSKeyboardDispatcher has no handle_key, so a dispatched ']' was
+                # silently ignored (2026-11-18 19:03, real run).
+                if wbc_goal.get("dwbc_policy_on", False) and not getattr(
